# Template for the per-package .env files. Copy, then fill in real values —
# this file is committed, so it must never contain a working credential.
#
#   cp .env.example web-packages/core/.env      # prisma CLI reads DATABASE_URL
#   cp .env.example web-packages/server/.env    # server runtime
#   cp .env.example web-packages/worker/.env    # worker daemon
#
# Real dev/prod database URLs are not in this repo — ask the team.

# ---- database ----
# Default below points at the optional local docker-compose Postgres. The shared
# remote dev database is what the team actually uses; see README.
DATABASE_URL="postgresql://idea:idea@localhost:5432/idea?schema=public"

# ---- server ----
PORT=3300

# Encrypts the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; a fixed dummy value is used in development so a fresh
# clone boots. Rotating it logs everyone out.
AUTH_SECRET=

# ---- worker ----
# Where the worker daemon reaches the API server.
IDEA_SERVER=http://localhost:3300
# Display handle. Defaults to the machine hostname when blank.
WORKER_NAME=
# Comma-separated agent capabilities this worker registers. The server matches
# work against these, so a worker declaring nothing receives nothing.
WORKER_CAPABILITIES=requirement-elicitation

# ---- private object storage (AliCloud OSS) ----
# Browser uploads use the bucket's public endpoint. Objects stay private and
# are read through short-lived signed URLs issued by the server.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=upivot-s2
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
