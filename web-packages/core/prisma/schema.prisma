// Identity and containers: who is acting, in which workspace, on which app.
//
// Table names are mapped explicitly to snake_case plural; column names stay
// camelCase as written here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  member

  @@map("role")
}

enum AppStatus {
  draft
  active
  archived

  @@map("app_status")
}

enum FileStatus {
  pending
  ready

  @@map("file_status")
}

enum IssueState {
  open
  closed

  @@map("issue_state")
}

enum IssueCloseReason {
  completed
  not_planned

  @@map("issue_close_reason")
}

enum IssueType {
  bug
  feature
  task

  @@map("issue_type")
}

enum IssueFileRole {
  image
  attachment

  @@map("issue_file_role")
}

enum IssueActivityKind {
  state_changed
  type_changed
  label_added
  label_removed

  @@map("issue_activity_kind")
}

enum TurnStatus {
  queued
  running
  completed
  failed
  // Stopped on purpose. Kept apart from `failed` because nothing went wrong —
  // the interface must not render it as an error.
  aborted

  @@map("turn_status")
}

// Identity only. Authorization lives in separate tables so this one does not
// grow a new boolean column every time a permission is added.
model User {
  id           Int      @id @default(autoincrement())
  // Login identifier, chosen by the invitee. Stored lowercase — otherwise
  // "Zhang" and "zhang" are two accounts and the unique constraint stops being
  // an impersonation defence.
  username     String   @unique
  // scrypt, per-user salt, parameters recorded inline. See src/crypto.ts.
  passwordHash String
  // Display name. Not unique — two colleagues may share a common name.
  name         String
  // Optional, E.164-normalised. Reserved for SMS password recovery, and
  // unusable for that until a verification flow exists.
  phone        String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaces           UserWorkspace[]
  platformAdmin        PlatformAdmin?
  preference           UserPreference?
  invitesSent          Invite[]          @relation("InvitedBy")
  invitesAccepted      Invite[]          @relation("AcceptedBy")
  appsCreated          App[]
  conversations        Conversation[]
  filesUploaded        File[]
  enrolments           WorkerEnrolment[]
  issuesCreated        Issue[]           @relation("IssueCreatedBy")
  issuesUpdated        Issue[]           @relation("IssueUpdatedBy")
  issuesClosed         Issue[]           @relation("IssueClosedBy")
  issueRevisionsEdited IssueRevision[]   @relation("IssueRevisionEditedBy")
  issueActivities      IssueActivity[]   @relation("IssueActivityActor")

  @@map("users")
}

// Per-user preferences, kept out of `users` for the same reason platform_admins
// is: that table answers "who are you", while preferences keep accumulating
// (theme, language, default view later) and would turn it into a junk drawer.
model UserPreference {
  userId          Int      @id
  // Interface language. Null means "never chosen" — the client then follows the
  // browser rather than being forced to a default the user did not pick.
  locale          String?
  // Where to drop the user on their next sign-in.
  //
  // The foreign key guarantees the workspace still EXISTS. It does not
  // guarantee the user is still a member of it — removing someone from a
  // workspace leaves the workspace intact, so this can point somewhere they can
  // no longer enter. Membership is rechecked on read; see resolveEntryWorkspace.
  lastWorkspaceId Int?
  updatedAt       DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a workspace should clear this pointer, not
  // delete the user's whole preference row along with it.
  lastWorkspace Workspace? @relation(fields: [lastWorkspaceId], references: [id], onDelete: SetNull)

  @@map("user_preferences")
}

// Platform-level authorization, deliberately its own table rather than a flag on
// User: authorization keeps evolving and User should not accumulate a boolean
// per capability. Presence of the row is the grant, which also gives a natural
// "when", and makes revocation a delete rather than a silent field flip.
//
// Grants only the ability to CREATE workspaces. It grants no visibility — a
// platform admin reads data through exactly the same membership filter as
// everyone else.
model PlatformAdmin {
  userId    Int      @id
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

// The tenant boundary. Every query for anything below it filters by membership.
model Workspace {
  id          Int      @id @default(autoincrement())
  systemAppId Int?     @unique
  // Not globally unique: two different customers may both have a "Design" team.
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserWorkspace[]
  apps        App[]             @relation("WorkspaceApps")
  systemApp   App?              @relation("WorkspaceSystemApp", fields: [systemAppId], references: [id], onDelete: SetNull)
  invites     Invite[]
  preferredBy UserPreference[]
  workers     Worker[]
  enrolments  WorkerEnrolment[]

  @@map("workspaces")
}

// Named structurally rather than as a domain concept: "Membership" is left
// unclaimed for something that may later carry business meaning.
//
// The row's existence answers visibility; `role` answers only whether the user
// may administer other members. Role never gates reading data.
model UserWorkspace {
  userId      Int
  workspaceId Int
  role        Role     @default(member)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("user_workspaces")
}

// A piece of software being created. Issue numbering is local to it.
model App {
  id            Int       @id @default(autoincrement())
  workspaceId   Int
  slug          String
  name          String
  description   String?
  status        AppStatus @default(active)
  issueSequence Int       @default(0)
  createdById   Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace          Workspace      @relation("WorkspaceApps", fields: [workspaceId], references: [id], onDelete: Cascade)
  systemForWorkspace Workspace?     @relation("WorkspaceSystemApp")
  createdBy          User           @relation(fields: [createdById], references: [id])
  conversations      Conversation[]
  files              File[]
  issues             Issue[]
  labels             Label[]

  @@unique([workspaceId, slug])
  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("apps")
}

// A private object uploaded for one app. The workspace boundary is reached
// through App rather than copied onto this row.
model File {
  id           Int        @id @default(autoincrement())
  fid          String     @unique
  appId        Int
  uploadedById Int
  filename     String     @db.VarChar(255)
  contentType  String     @db.VarChar(128)
  size         Int
  storageKey   String     @unique @db.VarChar(512)
  status       FileStatus @default(pending)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  app                App                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  uploadedBy         User                @relation(fields: [uploadedById], references: [id])
  issueFiles         IssueFile[]
  issueRevisionFiles IssueRevisionFile[]

  @@index([appId, createdAt])
  @@map("files")
}

// A conversation with the agent. It belongs to one app; associations with
// issues and other resources stay separate until their semantics exist.
model Conversation {
  id                Int      @id @default(autoincrement())
  cid               String   @unique
  appId             Int
  createdById       Int
  // The backend is stable for the lifetime of the conversation. The current
  // worker may move, but only to another worker serving this same provider.
  providerId        Int
  // Current execution machine. Null only after that worker is deleted; the
  // conversation remains durable and can be assigned to a replacement.
  workerId          Int?
  // The provider's own session handle, used to resume rather than replay. Null
  // until the first turn has run.
  providerSessionId String?
  // Conversation-wide runtime overrides. Null means use the provider default.
  model             String?
  effort            String?
  title             String?
  // Set once a person names it, which stops the automatic title from
  // overwriting a deliberate choice.
  titleLocked       Boolean  @default(false)
  createdAt         DateTime @default(now())
  // `updatedAt` only moves when a column changes, so it reports a rename as
  // activity and a long conversation as idle. This is the honest "last spoke".
  lastActiveAt      DateTime @default(now())

  app       App                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  createdBy User                @relation(fields: [createdById], references: [id])
  provider  Provider            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  worker    Worker?             @relation(fields: [workerId], references: [id], onDelete: SetNull)
  events    ConversationEvent[]
  pending   PendingInput[]
  turns     Turn[]

  @@index([appId, lastActiveAt])
  @@map("conversations")
}

model Issue {
  id               Int               @id @default(autoincrement())
  appId            Int
  number           Int
  title            String
  body             String
  state            IssueState        @default(open)
  type             IssueType?
  closeReason      IssueCloseReason?
  revisionSequence Int               @default(1)
  createdById      Int
  updatedById      Int
  closedById       Int?
  closedAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  app        App             @relation(fields: [appId], references: [id], onDelete: Cascade)
  createdBy  User            @relation("IssueCreatedBy", fields: [createdById], references: [id])
  updatedBy  User            @relation("IssueUpdatedBy", fields: [updatedById], references: [id])
  closedBy   User?           @relation("IssueClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  labels     IssueLabel[]
  files      IssueFile[]
  revisions  IssueRevision[]
  activities IssueActivity[]

  @@unique([appId, number])
  @@index([appId, state, updatedAt])
  @@index([appId, type])
  @@map("issues")
}

model Label {
  id             Int      @id @default(autoincrement())
  appId          Int
  name           String   @db.VarChar(50)
  normalizedName String   @db.VarChar(50)
  description    String?  @db.VarChar(100)
  color          String   @db.VarChar(6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  app        App             @relation(fields: [appId], references: [id], onDelete: Cascade)
  issues     IssueLabel[]
  activities IssueActivity[]

  @@unique([appId, normalizedName])
  @@index([appId, name])
  @@map("labels")
}

model IssueLabel {
  issueId Int
  labelId Int

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
  @@map("issue_labels")
}

model IssueRevision {
  id         Int      @id @default(autoincrement())
  issueId    Int
  number     Int
  title      String
  body       String
  editedById Int
  createdAt  DateTime @default(now())

  issue    Issue               @relation(fields: [issueId], references: [id], onDelete: Cascade)
  editedBy User                @relation("IssueRevisionEditedBy", fields: [editedById], references: [id])
  files    IssueRevisionFile[]

  @@unique([issueId, number])
  @@index([issueId, createdAt])
  @@map("issue_revisions")
}

model IssueFile {
  issueId  Int
  fileId   Int
  role     IssueFileRole
  position Int

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  file  File  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([issueId, fileId])
  @@unique([issueId, role, position])
  @@index([fileId])
  @@map("issue_files")
}

model IssueRevisionFile {
  revisionId Int
  fileId     Int
  role       IssueFileRole
  position   Int

  revision IssueRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  file     File          @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([revisionId, fileId])
  @@unique([revisionId, role, position])
  @@index([fileId])
  @@map("issue_revision_files")
}

model IssueActivity {
  id          Int               @id @default(autoincrement())
  issueId     Int
  kind        IssueActivityKind
  actorId     Int
  fromState   IssueState?
  toState     IssueState?
  closeReason IssueCloseReason?
  fromType    IssueType?
  toType      IssueType?
  labelId     Int?
  labelName   String?           @db.VarChar(50)
  labelColor  String?           @db.VarChar(6)
  createdAt   DateTime          @default(now())

  issue Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User   @relation("IssueActivityActor", fields: [actorId], references: [id])
  label Label? @relation(fields: [labelId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
  @@index([labelId])
  @@map("issue_activities")
}

// The append-only transcript, and the only account of what happened. `sequence`
// is per-conversation and assigned inside the append transaction; readers order
// and de-duplicate by it, which is what makes a dropped live frame recoverable
// by asking again rather than by tracking delivery.
//
// `payload` holds a canonical ConversationEvent (see @idea/shared), including
// the provider's `raw` payload. That field never leaves the server — see
// toWireEvent.
model ConversationEvent {
  id             Int      @id @default(autoincrement())
  conversationId Int
  sequence       Int
  // The canonical event type, duplicated out of the payload so the common
  // queries ("just the agent's messages") are an index scan.
  type           String
  payload        Json
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@index([conversationId, type])
  @@map("conversation_events")
}

// Typed but not yet sent. Deliberately NOT an event: the transcript records what
// happened, and this has not happened yet.
//
// Keeping it separate buys two things a durable-transcript-only design cannot
// have. Several of these merge into ONE user message when a turn finally starts,
// so someone thinking out loud in three bursts gets one considered reply rather
// than three partial ones. And an unsent line can still be withdrawn, which is
// impossible once it is history.
model PendingInput {
  id             Int      @id @default(autoincrement())
  conversationId Int
  text           String
  attachments    Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
  @@map("pending_inputs")
}

// One unit of agent work. Exists as a row rather than being derived from the
// transcript because status, retries and leases are execution state rather than
// conversation history. The conversation owns the current worker assignment.
model Turn {
  id                Int        @id @default(autoincrement())
  conversationId    Int
  // Points at the exact transcript event this turn is answering.
  userEventSequence Int
  status            TurnStatus @default(queued)
  // Holds the conversation id while running, and null otherwise. The unique
  // index is the whole mutual-exclusion mechanism: a second worker claiming a
  // turn for a conversation that already has one running collides here and backs
  // off. No lock service, no coordination.
  runningKey        String?    @unique
  // A claim is a lease, not a handover. Renewed by turn heartbeats — a single
  // long tool call emits nothing else for minutes, and without renewal the
  // reaper would take the turn away and run it a second time.
  leaseUntil        DateTime?
  attempt           Int        @default(0)
  abortRequestedAt  DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([status, leaseUntil])
  @@map("turns")
}

// An agent daemon. Keyed by machine and NOT by app: one process serves every
// application, and which work reaches it is decided by its capabilities rather
// than by its identity. The alternative — a daemon per app per machine — puts
// the process count on a product of two numbers that both grow.
//
// Liveness is not tracked here. A worker is usable exactly while its command
// stream is connected, which removes an entire layer of timeout tuning; the
// heartbeat endpoint exists only so the daemon can tell it has lost the server
// and exit for its supervisor to restart.
model Worker {
  id          Int      @id @default(autoincrement())
  // Which workspace this worker serves, and it serves exactly one. That is a
  // security boundary before it is a routing rule: the agent runs untrusted
  // instructions — a message, or text inside a repository it reads — so the
  // process it runs in is confined to one tenant's data, and the claim query
  // refuses to hand it anything else even if that confinement is defeated.
  workspaceId Int
  // Stable per machine, so a restarted daemon recovers its identity rather than
  // leaving a dead row behind. In a container this lives on the workspace's
  // volume, which survives the container being rebuilt.
  machineId   String
  // Display handle, so an operator can tell two workers apart.
  name        String
  hostname    String
  // Reissued on every registration; only its hash is stored.
  apiToken    String   @unique
  // Which agent backend this worker runs. A property of the deployment, not of
  // the tenant: whoever starts the container decides, by giving it that
  // provider's credentials and SDK. Wanting two backends means running two
  // containers, which is also how you get them isolated from each other.
  //
  // This IS the routing capability — a separate capability list would be a less
  // precise way of saying the same thing.
  providerId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Restrict: a provider still being served by a worker should not be deletable
  // out from under it.
  provider      Provider       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  conversations Conversation[]

  @@unique([workspaceId, machineId])
  @@unique([workspaceId, name])
  @@map("workers")
}

// Lets a worker prove which workspace it may serve. A container cannot be
// allowed to name its own tenant, and it has no user to sign in as.
//
// Same shape as an invite: only the hash is stored, the token itself is shown
// once at creation. Revoking is deleting the row.
model WorkerEnrolment {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  tokenHash   String    @unique
  // What this token is for — "mac-mini", "ci" — so revoking the right one does
  // not require guessing.
  label       String
  createdById Int
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([workspaceId])
  @@map("worker_enrolments")
}

// An agent backend. `name` is which provider (glm, deepseek, codex); `kind` is
// which SDK speaks to it (claude, codex). They are separate axes: GLM and
// DeepSeek are both `claude` and differ only by endpoint, which is exactly why
// one adapter serves both.
//
// Platform-level, not per workspace: the endpoints and models are ours, not a
// tenant's. A workspace chooses among the enabled ones.
model Provider {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  label     String
  kind      String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  // { baseUrl, model, tokenEnv }.
  //
  // NO CREDENTIALS. `tokenEnv` is the NAME of the environment variable holding
  // the token, never its value — the database says where to look and never what
  // it is, so a database dump yields nothing usable. The values live in the
  // worker's environment.
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workers       Worker[]
  conversations Conversation[]

  @@map("providers")
}

// A bearer capability, not a letter addressed to someone: the admin generating
// it does not know who will use it, so it carries no identity. Whoever holds the
// link picks their own username on the way in.
//
// Single-use. `acceptedAt` set means spent; `acceptedById` records who spent it,
// so "who let this person in" stays answerable afterwards.
model Invite {
  id           Int       @id @default(autoincrement())
  workspaceId  Int
  role         Role      @default(member)
  // SHA-256 of the token. The link itself is shown once, at creation, and never
  // stored — a database leak yields no usable invitations.
  tokenHash    String    @unique
  invitedById  Int
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById Int?
  createdAt    DateTime  @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy User?     @relation("AcceptedBy", fields: [acceptedById], references: [id])

  @@index([workspaceId])
  @@map("invites")
}
